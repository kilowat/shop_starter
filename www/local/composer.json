{
    "name": "bitrix/shop",
    "description": "Bitrix Project",
    "type": "project",
    "require": {
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Controllers\\": "controllers/",
            "Components\\": "components/",
            "Lib\\": "lib/"
        },
        "files": [
            "config/services.php"
        ]
    },
    "config": {
        "process-timeout": 1800,
        "vendor-dir": "./vendor",
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "merge-plugin": {
            "require": [
                "../bitrix/composer-bx.json"
            ]
        }
    }
}